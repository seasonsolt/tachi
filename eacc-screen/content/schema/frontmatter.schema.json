{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-acc.ai/schemas/content-frontmatter.schema.json",
  "title": "E-ACC content frontmatter",
  "description": "Practical frontmatter contract for the phase-1 e-acc.ai content surface.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "slug",
    "title",
    "cluster",
    "intent",
    "ctaType",
    "updatedAt",
    "monetizationMode",
    "description"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "cluster": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "intent": {
      "type": "string",
      "minLength": 3
    },
    "ctaType": {
      "type": "string",
      "enum": [
        "affiliate",
        "newsletter",
        "internal-lab",
        "internal-navigation",
        "lead-magnet",
        "sponsor",
        "hybrid"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "monetizationMode": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "affiliate",
          "ads",
          "newsletter",
          "internal",
          "internal-navigation",
          "sponsorship"
        ]
      }
    },
    "pageType": {
      "type": "string",
      "enum": ["home", "hub", "workflow", "comparison", "lab"]
    },
    "primaryRoute": {
      "type": "string",
      "pattern": "^/(?:$|[a-z0-9-]+(?:/[a-z0-9-]+)*)$"
    },
    "status": {
      "type": "string",
      "enum": ["launch-batch", "preserved", "backlog"]
    },
    "estimatedReadMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "hero": {
      "type": "string"
    },
    "featuredHubSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    },
    "featuredWorkflowSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    },
    "featuredComparisonSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    },
    "relatedHubSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    },
    "relatedWorkflowSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    },
    "relatedComparisonSlugs": {
      "type": "array",
      "items": { "$ref": "#/$defs/slugRef" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "slugRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
